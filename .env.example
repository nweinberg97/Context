# Copy to .env.local for local development. Never commit real values.
# Everything except DATABASE_URL is optional: missing services switch the product into
# a clearly labelled development mode instead of pretending the integration works.

# --- Core -------------------------------------------------------------------
APP_URL=http://localhost:3000
# Local (docker compose up -d db):
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres
# Supabase: use the pooled connection string (Project Settings → Database →
# Connection pooling, transaction mode) for serverless hosting.
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Authentication -----------------------------------------------------------
# Set both to use Supabase Auth. Leave empty for local development sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Needed to delete the auth identity when someone deletes their account.
SUPABASE_SERVICE_ROLE_KEY=

# Local development sign-in (used only when Supabase is not configured).
# Min 32 chars. A built-in development value is used if unset (not in production).
LOCAL_AUTH_SECRET=
# Production builds refuse local sign-in unless this is "true" (local testing only).
CONTEXT_ALLOW_LOCAL_AUTH=

# --- Extraction -----------------------------------------------------------------
# "anthropic" sends pasted text to the Anthropic API. "rules" (default without a key)
# uses the on-server rule-based development reader — not AI.
EXTRACTION_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Email check-ins ------------------------------------------------------------
# "resend" sends real email. "outbox" writes emails to .data/outbox for local testing.
# Empty = check-ins disabled (everything else works).
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM="Context <checkins@your-domain.example>"
# Signing secret for the delivery-status webhook (whsec_...).
EMAIL_WEBHOOK_SECRET=
MAX_EMAILS_PER_DAY=90

# --- Scheduler ------------------------------------------------------------------
# Shared secret for /api/cron/dispatch (min 16 chars). Required for check-ins.
CRON_SECRET=
